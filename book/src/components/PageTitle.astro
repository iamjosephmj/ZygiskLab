---
// Override of Starlight's PageTitle.astro. Frontmatter `status` is the
// single source of truth for a chapter's verification state - the badge
// is rendered from it directly.
// Starlight's PAGE_TITLE_ID ('_top') isn't part of the package's public
// export map (only ./constants.ts internally), so it's inlined here rather
// than imported - it's used only as the skip-link anchor target.
const PAGE_TITLE_ID = '_top';
---

<h1 id={PAGE_TITLE_ID}>{Astro.locals.starlightRoute.entry.data.title}</h1>

{
  Astro.locals.starlightRoute.entry.data.status === 'proven' && (
    <span class="zl-status" data-status="proven">Proven</span>
  )
}
